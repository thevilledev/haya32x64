{
	"name": "haya32x64",
	"version": "0.1.0",
	"description": "A high-quality 64-bit hash built entirely from 32-bit operations",
	"type": "module",
	"license": "Unlicense",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thevilledev/haya32x64.git"
	},
	"keywords": [
		"hash",
		"hashing",
		"64-bit",
		"javascript",
		"wasm"
	],
	"engines": {
		"node": ">=18"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
