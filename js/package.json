		"./pure": {
			"types": "./pure.d.ts",
			"import": "./pure.js"
		},
		"./haya32x64.wasm": "./wasm/haya32x64.wasm"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"pure.js",
		"pure.d.ts",
		"wasm.js",
		"wasm-module.js",
		"wasm/haya32x64.wasm",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build:wasm": "sh wasm/build.sh",
		"test": "node --test",
		"test:package": "npm pack --dry-run"
