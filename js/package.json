{
	"name": "haya32x64",
	"version": "0.2.0",
	"description": "A non-cryptographic 64-bit hash built entirely from 32-bit operations",
	"type": "module",
	"license": "Unlicense",
	"author": "Ville Vesilehto <ville@vesilehto.fi>",
	"homepage": "https://github.com/thevilledev/haya32x64#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thevilledev/haya32x64.git",
		"directory": "js"
	},
	"bugs": "https://github.com/thevilledev/haya32x64/issues",
	"keywords": [
		"hash",
		"hayahash",
		"fast-hash",
		"non-cryptographic",
		"hashing",
		"64-bit",
		"32-bit",
		"javascript",
		"wasm",
		"webassembly"
	],
	"engines": {
		"node": ">=18"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		},
		"./pure": {
			"types": "./pure.d.ts",
			"import": "./pure.js"
		},
		"./haya32x64.wasm": "./wasm/haya32x64.wasm"
	},
	"sideEffects": false,
	"files": [
		"index.js",
		"index.d.ts",
		"pure.js",
		"pure.d.ts",
		"wasm.js",
		"wasm-module.js",
		"wasm/haya32x64.wasm",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build:wasm": "sh wasm/build.sh",
		"test": "node --test",
		"test:package": "npm pack --dry-run"
	}
}
